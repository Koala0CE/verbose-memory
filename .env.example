# =============================================================================
# Copy this file to .env.local and fill in your real values.
# Do not commit .env.local (it is in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Auth0 v4 (required for login / profile)
# Get these from: Auth0 Dashboard → Applications → Your App → Settings
# -----------------------------------------------------------------------------
AUTH0_SECRET=                             # Run: openssl rand -hex 32
APP_BASE_URL=http://localhost:3000        # Your app URL (use your Vercel URL in production)
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com     # Auth0 domain only, no https://
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# For client-side role checks (e.g. roleChecker) – set to same value as AUTH0_DOMAIN
NEXT_PUBLIC_AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com

# -----------------------------------------------------------------------------
# Contentful (for timeline / gallery content)
# Get these from: Contentful → Space settings → API keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=
NEXT_PUBLIC_CONTENTFUL_CONTENT_TYPE=       # e.g. the ID of your "memory" or "photo" content type

# Optional: used by lib/contentful.ts if you use the server Contentful client
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:3000
